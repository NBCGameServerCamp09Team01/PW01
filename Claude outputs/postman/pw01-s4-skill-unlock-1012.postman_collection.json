        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('상태', () => pm.expect(d.skills.map(s => s.state)).to.eql(['UNLOCKABLE', 'LOCKED', 'LOCKED']));",
              "pm.test('Dodge 플레이 시간 60초 미충족', () => { const r = d.skills[1].requirements[2]; pm.expect(r.type).to.eql('PLAY_TIME_SECONDS'); pm.expect(r.current).to.eql(60); pm.expect(r.met).to.eql(false); });",
              "pm.test('CounterPlus 선행 Combo4 미충족', () => { const r = d.skills[2].requirements[0]; pm.expect(r.type).to.eql('PREREQUISITE'); pm.expect(r.key).to.eql('Account.Skill.Combo4'); pm.expect(r.met).to.eql(false); });"
            ]
          }
        }
      ]
    },
