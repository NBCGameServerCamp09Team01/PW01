{
  "info": {
    "name": "PW01 S4 스킬 해금 시험 (10/12)",
    "description": "스킬 해금 API(루트 docs/contracts/skill-api.md: K1 POST /accounts/me/skill-unlocks, K2 GET /accounts/me/skills). 서버는 PW01WebServer feat/s4-skill. 01이 매번 새 계정(pmsk + 숫자 8자리)을 만들고, 스테이지 1을 두 번 깨서(각 60초·처치 6) 조건을 채우며 세 스킬을 해금한다. 이름에 [S4]가 붙은 요청이 이번 기능. 결과 플레이 시간은 '시작 뒤 지난 시간 + 60초' 이하여야 해서 한 번에 60초까지만 보낸다(두 번 = 120초, DodgeMastery 경계값). 동시 해금·Redis 기억이 사라진 뒤의 ALREADY_SAVED·누적 통계 대조는 자동 시험(SkillApiTest·StatTotalReconcilerTest)이 맡는다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 공통: X-Request-Id 헤더, 성공이면 {data, meta}, 4xx 오류면 retryable 칸이 있음",
          "const rid = pm.response.headers.get('X-Request-Id');",
          "pm.test('[공통] X-Request-Id 헤더', () => pm.expect(rid).to.be.a('string').and.not.empty);",
          "if (pm.response.text()) {",
          "  const b = pm.response.json();",
          "  if (pm.response.code < 300) {",
          "    pm.test('[공통] {data, meta}', () => { pm.expect(b).to.have.property('data'); pm.expect(b.meta.requestId).to.eql(rid); });",
          "  } else {",
          "    pm.test('[공통] 오류 본문 code·retryable', () => { pm.expect(b.code).to.be.a('string'); pm.expect(b).to.have.property('retryable'); });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "loginId",
      "value": ""
    },
    {
      "key": "nickname",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "play",
      "value": ""
    },
    {
      "key": "rid",
      "value": ""
    },
    {
      "key": "firstRid",
      "value": ""
    },
    {
      "key": "firstData",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 가입(새 계정)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\"loginId\": \"{{loginId}}\", \"password\": \"pms4pass1234\", \"nickname\": \"{{nickname}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = Math.floor(Math.random() * 1e8).toString().padStart(8, '0');",
              "pm.collectionVariables.set('loginId', 'pmsk' + n);",
              "pm.collectionVariables.set('nickname', '스킬' + n.slice(-6));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"loginId\": \"{{loginId}}\", \"password\": \"pms4pass1234\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const a = pm.response.json().data.account;",
              "pm.test('unlockedSkills 빈 배열', () => pm.expect(a.unlockedSkills).to.eql([]));",
              "pm.collectionVariables.set('token', pm.response.json().data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 [S4] 진행도(K2): 세 스킬 모두 LOCKED, 포인트 0",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/me/skills"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('스킬 3개, 파일 순서', () => pm.expect(d.skills.map(s => s.skillTag)).to.eql(['Account.Skill.Combo4', 'Account.Skill.DodgeMastery', 'Account.Skill.CounterPlus']));",
              "pm.test('모두 LOCKED', () => pm.expect(d.skills.map(s => s.state)).to.eql(['LOCKED', 'LOCKED', 'LOCKED']));",
              "pm.test('statPoints 0', () => pm.expect(d.statPoints).to.eql(0));",
              "pm.test('Combo4 조건: 비용 → 클리어', () => pm.expect(d.skills[0].requirements.map(r => r.type)).to.eql(['STAT_POINTS', 'STAGES_CLEARED']));",
              "pm.test('CounterPlus 최고 클리어: 기록 없음(null), 이하', () => { const r = d.skills[2].requirements[4]; pm.expect(r.type).to.eql('BEST_CLEAR_TIME'); pm.expect(r.current).to.eql(null); pm.expect(r.upperBound).to.eql(true); pm.expect(r.met).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 [S4] Combo4 해금 → 409 SKILL_REQUIREMENTS_NOT_MET (포인트·클리어 없음)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/me/skill-unlocks",
        "body": {
          "mode": "raw",
          "raw": "{\"requestId\": \"{{$guid}}\", \"skillTag\": \"Account.Skill.Combo4\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));",
              "const b = pm.response.json();",
              "pm.test('code·retryable false', () => { pm.expect(b.code).to.eql('SKILL_REQUIREMENTS_NOT_MET'); pm.expect(b.retryable).to.eql(false); });",
              "pm.test('requirements 두 줄, 둘 다 미충족', () => { pm.expect(b.requirements.map(r => [r.type, r.met])).to.eql([['STAT_POINTS', false], ['STAGES_CLEARED', false]]); });",
              "pm.test('기능별 추가 칸만(extra 없음)', () => pm.expect(b).to.not.have.property('extra'));"
            ]
          }
        }
      ]
    },
