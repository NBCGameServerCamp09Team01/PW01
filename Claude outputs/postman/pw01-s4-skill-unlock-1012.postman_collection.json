    {
      "name": "07 [S4] 진행도: Combo4 UNLOCKABLE, Dodge LOCKED(플레이 60초 < 120), CounterPlus LOCKED(선행)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
